# ============================================================
# Resonance Music Explorer — Environment Configuration
# ============================================================
# Copy this file to .env and fill in your credentials.
#
#   cp .env.example .env
#
# The application works without any credentials using:
#   - iTunes  (search + 30-sec previews, no key required)
#   - Deezer  (search + 30-sec previews, no key required)
#   - Audius  (search + full playback, no key required)
#
# The following providers require credentials:
#   - Jamendo (search + full playback, free client_id)
#   - YouTube (search via Data API, playback via IFrame embed)
# ============================================================

# --- Audius (optional, works without key) ---
# Audius public discovery endpoints work without a key.
# Only set this if you have a registered Audius API key.
AUDIUS_API_KEY=
AUDIUS_APP_NAME=music-explorer

# --- Jamendo (optional, requires free registration) ---
# Register at: https://developer.jamendo.com/v3.0
# Jamendo provides free, Creative Commons–licensed music
# with direct MP3 playback URLs.
JAMENDO_CLIENT_ID=

# --- YouTube (optional, requires Google Cloud project) ---
# YouTube search uses the Data API v3 (server-side, key required).
# YouTube playback uses the IFrame Player API (browser-side, no key).
# Register at: https://console.cloud.google.com
YOUTUBE_API_KEY=

# --- Server ---
PORT=3000
NODE_ENV=development